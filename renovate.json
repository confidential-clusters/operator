{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "schedule:weekly"
  ],
  "rebaseWhen": "conflicted",
  "ignorePaths": [
    "drift-cache"
  ],
  "cloneSubmodules": true,
  "dockerfile": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Only propose Go dependency updates compatible with this repo's go.mod Go version",
      "matchManagers": ["gomod"],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Only propose Cargo dependency updates compatible with Rust 1.92",
      "matchManagers": ["cargo"],
      "constraintsFiltering": "strict",
      "constraints": {
        "rust": "1.92"
      }
    }
  ]
}
